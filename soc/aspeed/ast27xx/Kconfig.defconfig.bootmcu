if SOC_AST2700_BOOTMCU || SOC_AST2700_A1_BOOTMCU

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 1000000

config RISCV_SOC_INTERRUPT_INIT
	default y

config RISCV_HAS_CPU_IDLE
	default y

config RISCV_GP
	default y

config NUM_IRQS
	default 16

config PINCTRL
	default y

config CLOCK_CONTROL_INIT_PRIORITY
	default SYSCON_INIT_PRIORITY

config RESET_INIT_PRIORITY
	default SYSCON_INIT_PRIORITY

endif # SOC_AST2700_BOOTMCU || SOC_AST2700_A1_BOOTMCU
