config SOC_SERIES_AST1040
	bool
	select SOC_FAMILY_ASPEED
	help
	  Enable support for ASPEED AST1040 series

config SOC_SERIES_AST1040_CM4
	bool
	select SOC_SERIES_AST1040

config SOC_SERIES_AST1040_BOOTMCU
	bool
	select SOC_SERIES_AST1040

config SOC_AST1040_CM4
	bool
	select SOC_SERIES_AST1040_CM4
	help
	  AST1040 CM4 SOC

config SOC_AST1040_BOOTMCU
	bool
	select SOC_SERIES_AST1040_BOOTMCU
	help
	  AST1040 BOOTMCU SOC

config SOC_SERIES
	default "ast1040" if SOC_SERIES_AST1040

config SOC
	default "ast1040" if SOC_AST1040
