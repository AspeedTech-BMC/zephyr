config SOC_SERIES_AST27X0
	bool
	select SOC_FAMILY_ASPEED

config SOC_SERIES
	default "ast27x0" if SOC_SERIES_AST27X0

config SOC_AST2700
	bool
	select SOC_SERIES_AST27X0

config SOC_AST1700
	bool
	select SOC_SERIES_AST27X0

config SOC
	default "ast2700" if SOC_AST2700
	default "ast1700" if SOC_AST2700

config SOC_AST2700_SSP
	bool
	select SOC_AST2700
	help
	  Enable support for AST2700 SSP

config SOC_AST2700_TSP
	bool
	select SOC_AST2700
	help
	  Enable support for AST2700 TSP
