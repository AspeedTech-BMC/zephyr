&ltpi0{
	status = "okay";
};

&ltpi1{
	status = "okay";
};

/ {
	chosen {
		zephyr,ram-console = &ram_console;
		zephyr,console = &ram_console;
	};

	ram_console: memory@14bac400 {
		compatible = "zephyr,memory-region";
		reg = <0x14bac400 0x1000>;
		zephyr,memory-region = "RAM_CONSOLE";
	};
};

&sram {
	reg = <0x14b80a00 0x2ba00>;
};

&fmc {
	status = "okay";
};

&fmc_cs0 {
	status = "okay";
	spi-max-buswidth = <1>;
	spi-max-frequency = <25000000>;
};

&spi0 {
	status = "okay";
	spi-ctrl-fifo-enabled;
};

&spi0_cs0 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};
