/* i3c0 controller to i3c1 target loopback. */
&i3c0 {
	status = "okay";
	assigned-address = <0x8>;
};

&i3c1 {
	status = "okay";
	secondary;
	dcr = <0xcc>;
	assigned-address = <0x9>;

	i3c1_smq: i3c-tmq@7ec80011000 {
		compatible = "i3c-target-mqueue";
		reg = <0x0 0x7ec 0x80011000>;
		msg-size = <128>;
		num-of-msgs = <4>;
		mandatory-data-byte = <0xbf>;
		status = "okay";
	};
};

/* Define the code partition required by the board DTS. */
&fmc_cs0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x0 0x100000>;
		};
	};
};
