 *
 * i2c4/i2c5 targets are defined by the board. Enable the conflict-free
 * i2c10/i2c11 loopback pair here; the other wired pairs conflict with the
 * board's PWM/TACH pinmux.
 */

&i2c10 {
	status = "okay";

	ipmb10: ipmb@6a {
		compatible = "aspeed,ipmb";
		reg = <0x6a>;
		size = <5>;
	};
};

&i2c11 {
	status = "okay";

	eeprom11: eeprom@4b {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x4b>;
		size = <256>;
	};
};
