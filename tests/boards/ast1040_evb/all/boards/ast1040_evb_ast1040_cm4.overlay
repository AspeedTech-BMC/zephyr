 *
 * GPIO, I2C, UART, SPI, and eSPI nodes required by the combined test image.
 */

/* GPIO loopback */

&gpio0 {
	status = "okay";
};

&gpio0_96_127 {
	status = "okay";
};

/* I2C loopback */

/*
 * i2c4/i2c5 targets are defined by the board. Other wired pairs are omitted
 * because they conflict with the board's PWM/TACH pinmux.
 */

&i2c10 {
	status = "okay";

	ipmb10: ipmb@6a {
		compatible = "aspeed,ipmb";
		reg = <0x6a>;
		size = <5>;
	};
};

&i2c11 {
	status = "okay";

	eeprom11: eeprom@4b {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x4b>;
		size = <256>;
	};
};

/*
 * UART internal loopback (MCR loopback bit) - never reaches the TX/RX pins,
 * so no pinctrl-0 is needed. uart12 is already enabled by the board dts as
 * the console/shell UART.
 */

&uart0 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart1 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart2 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart3 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart4 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart5 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart6 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart7 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart8 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart9 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart10 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&uart11 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

/*
 * SPI flash - see tests/boards/ast1040_evb/spi/boards for the per-device
 * offsets and why fmc_cs1 is left disabled.
 */

&fmc_cs0 {
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi0_cs0 {
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi0_cs1 {
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi1_cs0 {
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi1_cs1 {
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

/* eSPI auto-test (perif mcyc/oob/safs) */

&espi0 {
	status = "okay";
	perif-mcyc-enable;
	perif-mcyc-src-addr = <0x0 0x98000000>;
	perif-mcyc-size = <0x0 0x10000>;
	flash-edaf-mode = <1>;
};

&vuart0 {
	virtual,port = <0x3f8>;
	virtual,sirq = <4>;
	virtual,sirq-polarity = <0>;
	status = "okay";
};
