# SPDX-License-Identifier: Apache-2.0

config SNOOP_ASPEED
	bool "ASPEED LPC SNOOP driver"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables the snoop driver for ASPEED
	  SoCs.
	  Say y if you wish to use LPC data byte snooping
	  on ASPEED MCU.

config MAILBOX_ASPEED
	bool "ASPEED LPC Mailbox driver"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables the mailbox driver for ASPEED
	  SoCs.
	  Say y if you wish to use LPC mailbox on ASPEED MCU.

config PFR_SHELL_ASPEED
	bool "Enable ASPEED PFR shell"
	help
	  Enable PFR related control shell environment.

config PFR_FLOW_CTRL_AST1060
	bool "Enable ASPEED PFR Control Flow"
	help
	  This option enables the PFR related flow control,
	  including host reset and flash reset.

config ABR_FLOW_CTRL_ASPEED
	bool "Enable ASPEED ABR Control Flow"
	help
	  This option enables the ABR related flow control,
	  including disable FMC_WDT2 and reset ABR indicator.

config PCC_ASPEED
	bool "ASPEED LPC PCC driver"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables the PCC driver for ASPEED SoCs.
	  Note that PCC is not suitable for use with snooping
	  over eSPI.
	  Say y if you wish to use LPC PCC on ASPEED MCU.

config UART_ROUTING_ASPEED
	bool "ASPEED UART routing driver"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables UART routing driver for ASPEED SoCs.

config OTP_ASPEED
	bool "ASPEED OTP Utility"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables the OTP Utility for ASPEED SoCs.

config OTP_ASPEED_DRV_NAME
	string "Device name for ASPEED OTP device"
	default "OTP_ASPEED"
	depends on OTP_ASPEED
	help
	  Device name for ASPEED OTP device.

config SHELL_CMDS_OTP
	bool "Enable OTP shell commands"
	depends on OTP_ASPEED
	help
	  This option enables the OTP shell commands.

config OTP_AST27XX
	bool "ASPEED AST27XX OTP"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables the OTP Utility for ASPEED AST27XX SoCs Series.

config CPTRA_UPDATE
	bool "ASPEED CPTRA Update driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the Caliptra update driver for ASPEED SoCs.

config CPTRA_IFC
	bool "ASPEED CPTRA IFC driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the Caliptra ifc driver for ASPEED SoCs.

config CPTRA_MBOX
	bool "ASPEED CPTRA MBOX driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the Caliptra mbox driver for ASPEED SoCs.

config CPTRA_DICE
	bool "ASPEED CPTRA DICE driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the Caliptra dice driver for ASPEED SoCs.

config CPTRA_MISC
	bool "ASPEED CPTRA MISC driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the Caliptra misc driver for ASPEED SoCs.

config CPTRA_IPC
	bool "ASPEED CPTRA IPC driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the Caliptra ipc driver for ASPEED SoCs.

config LTPI_IPC
	bool "ASPEED LTPI IPC driver"
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the ltpi read / write ipc driver for ASPEED SoCs.

config CPTRA_IPC_SSP
	bool "ASPEED CPTRA IPC driver in SSP"
	depends on SOC_AST2700_SSP || SOC_AST2700_A1_SSP || SOC_AST2705_SSP
	help
	  This option enables the Caliptra ipc driver in SSP for ASPEED SoCs.

config CPTRA_MCI_MBOX
	bool "ASPEED CPTRA MCI mailbox driver"
	depends on SOC_SERIES_AST10x0_G2_CM4
	help
	  This option enables the Caliptra-SS MCI (Manageability Controller
	  Interface) mailbox driver for ASPEED SoCs.

config CPTRA_MCI_MISC
	bool "ASPEED CPTRA MCI mailbox commands"
	depends on CPTRA_MCI_MBOX
	help
	  This option enables the Caliptra-SS MCI mailbox command helpers
	  (firmware version, ...) for ASPEED SoCs.

config CPTRA_MCI_CRYPTOGRAPHIC_MBOX
	bool "ASPEED CPTRA MCI cryptographic mailbox (CM_*) commands"
	depends on CPTRA_MCI_MBOX
	help
	  This option enables the Caliptra-SS MCI cryptographic mailbox (CM_*)
	  commands operating on opaque Cmk key handles: MC_IMPORT, MC_CM_STATUS,
	  MC_RANDOM_STIR/MC_RANDOM_GENERATE, MC_ECDH_GENERATE/MC_ECDH_FINISH,
	  CMK-based ECDSA and ML-DSA-87 (sign/verify/public key), MC_HMAC,
	  MC_HMAC_KDF_COUNTER, MC_HKDF_EXTRACT/MC_HKDF_EXPAND, and AES/AES-GCM
	  encrypt/decrypt, for ASPEED SoCs.

config CPTRA_MCI_SHELL
	bool "ASPEED CPTRA MCI mailbox shell commands"
	depends on CPTRA_MCI_MISC
	depends on CPTRA_MCI_SHA
	depends on CPTRA_MCI_ECDSA
	depends on CPTRA_MCI_LMS
	depends on CPTRA_MCI_MLDSA
	depends on CPTRA_MCI_CRYPTOGRAPHIC_MBOX
	depends on SHELL
	help
	  This option enables shell commands to exercise the Caliptra-SS MCI
	  mailbox commands (firmware version, SHA, cryptographic mailbox, ...)
	  for testing.

config PRIVILEGE_CTRL
	bool "Enable ASPEED privilege control"
	default y
	depends on SOC_SERIES_AST27XX && DT_HAS_ASPEED_PRICTRL_ENABLED
	help
	  This option enables privilege control for aspeed
	  board isolation.

config EDAF_BRIDGE_ASPEED
	bool "Enable ASPEED eDAF bridge controller"
	default y
	depends on SOC_AST2700_BOOTMCU || SOC_AST2705_BOOTMCU
	help
	  This option enables the eDAF bridge controller
	  for ASPEED SoCs.

config ATC_ASPEED
	bool "ASPEED Anti-Tamper Controller (ATC) driver"
	depends on SOC_FAMILY_ASPEED
	help
	  This option enables the Anti-Tamper Controller driver for
	  ASPEED SoCs, including clock attack monitor, glitch detection,
	  IR drop detection and temperature sensor (TSENSE) tamper events.

module = MISC_ASPEED
module-str = misc-aspeed
source "subsys/logging/Kconfig.template.log_config"
