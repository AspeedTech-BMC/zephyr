config CACHE_ASPEED
bool "ASPEED external cache driver"
	depends on SOC_SERIES_AST10X0 || SOC_SERIES_AST26XX || SOC_SERIES_AST1040
	depends on SYSCON
	select CACHE_HAS_DRIVER
	help
	  This option enables the CACHE driver for ASPEED AST10X0 & AST26XX series SOC.

config CACHE_AST27XX
bool "ASPEED AST27XX external cache driver"
	depends on SOC_AST2700_SSP || SOC_AST2700_TSP || SOC_AST2700_A1_SSP || SOC_AST2700_A1_TSP
	select CACHE_HAS_DRIVER
	help
	  This option enables the CACHE driver for ASPEED AST27XX series SOC.