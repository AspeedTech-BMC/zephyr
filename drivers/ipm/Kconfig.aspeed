config IPM_AST2600
	bool "ASPEED AST2600 IPM driver"
	default y
	depends on DT_HAS_ASPEED_AST2600_IPC_ENABLED
	help
	  This option enables the IPM driver for ASPEED AST2600 series SOC.

config IPM_AST2700
	bool "ASPEED AST2700 IPM driver"
	default y
	depends on DT_HAS_ASPEED_AST2700_IPC_ENABLED || DT_HAS_ASPEED_AST2700_IPC_V2_ENABLED
	help
	  This option enables the IPM driver for ASPEED AST2700 series SOC.

config IPM_BOOTMCU
	bool "ASPEED IPC driver"
	default y
	depends on SOC_AST2700_BOOTMCU
	help
	  This option enables the IPC driver for ASPEED SoCs.

config IPM_ASPEED_SHELL
	bool "ASPEED AST2700 IPM Shell"
	default y
	depends on SHELL && (DT_HAS_ASPEED_AST2700_IPC_ENABLED || DT_HAS_ASPEED_AST2700_IPC_V2_ENABLED)
	help
	  Enable IPM Shell for ASPEED MCU IPM Usage.
