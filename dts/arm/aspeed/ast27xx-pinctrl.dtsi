	/*
	 * M16 and A15 are shared balls: the generic per-ball drive-strength
	 * control for them lives at 0x4d8, but once pinmux (sig_descs) is
	 * set to the FMC function below, the SCU actually honors the
	 * FMC-bus drive-strength register at 0x4e0 instead (same register
	 * used by the dedicated FMC-only balls). Point drive-strength-desc
	 * at 0x4e0 to match the FMC function selected here; 0x4d8 only
	 * applies when this ball is muxed to one of its other functions.
	 */
	/omit-if-no-ref/ pin_fwspidq2: pin_fwspidq2 {
		ball = <M16>;
