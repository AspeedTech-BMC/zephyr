#include <zephyr/dt-bindings/pinctrl/ast27xx-soc1-pinctrl.h>

&pinctrl1 {
	/* SCU3B0: USB Controller Register (PORTC/PORTD mode) */
	/omit-if-no-ref/ pin_usb2cud: pin_usb2cud {
		ball = <PORTC_MODE>;
		sig_descs = <SIG_DESC(0x3b0, 0, 0)>;
	};
	/omit-if-no-ref/ pin_usb2cd: pin_usb2cd {
		ball = <PORTC_MODE>;
		sig_descs = <SIG_DESC(0x3b0, 0, 1)>;
	};
	/omit-if-no-ref/ pin_usb2ch: pin_usb2ch {
		ball = <PORTC_MODE>;
		sig_descs = <SIG_DESC(0x3b0, 0, 2)>;
