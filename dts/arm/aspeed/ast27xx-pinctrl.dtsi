	/omit-if-no-ref/ pin_maclink1: pin_maclink1 {
		ball = <AC24>;
		sig_descs = <SIG_DESC(0x468, 28, 3)>;
		bias-disable-desc = <PINCFG_DESC(0x498, 23, 1)>;
	};

	/* SCU47C: SGMII Pin Control */
	/omit-if-no-ref/ pin_sgmii: pin_sgmii {
		ball = <SGMII0>;
		sig_descs = <SIG_DESC(0x47c, 0, 1)>;
	};

	/* SCU908: PCIe RC PERST Pin Control */
	/omit-if-no-ref/ pin_pe2sgrstn_0: pin_pe2sgrstn_0 {
		ball = <PCIERC2_PERST>;
		sig_descs = <SIG_DESC(0x908, 1, 1)>;
	};

	/omit-if-no-ref/ pin_fwspics0: pin_fwspics0 {
		ball = <C25>;
		drive-strength-desc = <PINCFG_DESC(0x4e0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_fwspics1: pin_fwspics1 {
		ball = <A13>;
		drive-strength-desc = <PINCFG_DESC(0x4e0, 2, 2)>;
	};

	/omit-if-no-ref/ pin_fwspics2: pin_fwspics2 {
		ball = <A12>;
		drive-strength-desc = <PINCFG_DESC(0x4e0, 4, 2)>;
	};

	/omit-if-no-ref/ pin_fwspiclk: pin_fwspiclk {
		ball = <C24>;
		drive-strength-desc = <PINCFG_DESC(0x4e0, 6, 2)>;
	};

	/omit-if-no-ref/ pin_fwspimosi: pin_fwspimosi {
		ball = <A17>;
		drive-strength-desc = <PINCFG_DESC(0x4e0, 8, 2)>;
	};

	/omit-if-no-ref/ pin_fwspimiso: pin_fwspimiso {
		ball = <A16>;
		drive-strength-desc = <PINCFG_DESC(0x4e0, 10, 2)>;
	};
};
