#include <arm/armv7-m.dtsi>
#include <mem.h>
#include <aspeed/ast10x0-irq.h>
#include <zephyr/dt-bindings/clock/ast27xx_clock.h>
#include <zephyr/dt-bindings/reset/ast27xx_reset.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/ast27xx-soc1-pinctrl-groups.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m4f";
			reg = <0>;
		};
	};

	dram_ro_region: memory@0 {
		device_type = "memory";
	};

	soc {
		intc_global: intc-global@72100000 {
			compatible = "aspeed,ast2700-intc-global", "syscon";
			reg = <0x72100000 0x2000>;
			#global-reg-cells = <2>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "okay";

			ipc_legacy: ipc_legacy@0 {
				compatible = "aspeed,ast2600-ipc";
				reg = <0x0 0x40>;
				interrupt-parent = <&nvic>;
				interrupts = <144 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <145 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <146 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <147 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <148 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <149 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <150 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <151 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <152 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <153 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <154 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <155 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <156 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <157 AST10X0_IRQ_DEFAULT_PRIORITY>,
							 <158 AST10X0_IRQ_DEFAULT_PRIORITY>;
				status = "disabled";
			};
		};

		syscon0: syscon@72c02000 {
			compatible = "syscon";
			reg = <0x72c02000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			ssp_cache: cache-controller@120 {
				reg = <0x120 0x40>;
				status = "disabled";
			};

			tsp_cache: cache-controller@160 {
				reg = <0x160 0x40>;
				status = "disabled";
			};

			sysrst0: reset-controller {
				compatible = "aspeed,ast27xx-reset";
				#reset-cells = <1>;
			};

			sysclk0: system-clock {
				compatible = "aspeed,ast27xx-scu0-clock";
				#clock-cells = <1>;
			};
		};

		timer0: timer@72c10000 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c10000 0x40>;
			interrupts = <16 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer1: timer@72c10040 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c10040 0x40>;
			interrupts = <17 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer2: timer@72c10080 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c10080 0x40>;
			interrupts = <18 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer3: timer@72c100c0 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c100c0 0x40>;
			interrupts = <19 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer4: timer@72c10100 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c10100 0x40>;
			interrupts = <20 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer5: timer@72c10140 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c10140 0x40>;
			interrupts = <21 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer6: timer@72c10180 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c10180 0x40>;
			interrupts = <22 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		timer7: timer@72c101c0 {
			compatible = "aspeed,ast27xx-timer";
			reg = <0x72c101c0 0x40>;
			interrupts = <23 1>;
			clocks = <&sysclk0 SCU0_CLK_APB>;
			status = "disabled";
		};

		uart4: serial@72c1a000 {
			compatible = "ns16550";
			reg = <0x72c1a000 0x1000>;
			interrupts = <8 0>;
			clocks = <&sysclk0 SCU0_CLK_GATE_UART4CLK>;
			status = "disabled";
			reg-shift = <2>;
		};

		ipc0: bus@72c1c000 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "simple-bus";
			interrupt-parent = <&nvic>;
			ranges = <0 0x72c1c000 0x1000>;
		};

		syscon1: syscon@74c02000 {
			compatible = "syscon";
			reg = <0x74c02000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			sysrst1: reset-controller {
				compatible = "aspeed,ast27xx-reset";
				#reset-cells = <1>;
			};

			sysclk1: system-clock {
				compatible = "aspeed,ast27xx-scu1-clock";
				#clock-cells = <1>;
			};

			pinctrl1: pinctrl {
				compatible = "aspeed,g7-soc1-pinctrl";
			};
		};

		rng: hwrng@74c020f0 {
			compatible = "aspeed,hwrng";
			reg = <0x74c020f0 0x8>;
			status = "disabled";
		};

		espi0: espi@74c05000 {
			compatible = "aspeed,espi-v2";
			reg = <0x74c05000 0x1000>;
			interrupt-parent = <&intc1_0>;
			interrupts = <10 1>;
			clocks = <&sysclk1 SCU1_CLK_GATE_ESPI0CLK>;
			status = "disabled";
		};

		intc1_global: intc-global@74c18000 {
			compatible = "aspeed,ast2700-intc-global", "syscon";
			reg = <0x74c18000 0x2000>;
			#global-reg-cells = <2>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "okay";
		};

		uart0: serial@74c33000 {
			compatible = "ns16550";
			reg = <0x74c33000 0x100>;
			interrupt-parent = <&intc1_4>;
			interrupts = <7 1>;
			status = "disabled";
			reg-shift = <2>;
		};

		uart6: serial@74c33500 {
			compatible = "ns16550";
			reg = <0x74c33500 0x100>;
			interrupt-parent = <&intc1_4>;
			interrupts = <12 1>;
			clocks = <&sysclk1 SCU1_CLK_GATE_UART6CLK>;
			resets = <&sysrst1 SCU1_RESET_UART6>;
			pinctrl-names = "default";
			pinctrl-0 = <pinctrl_uart6_default>;
			status = "disabled";
			reg-shift = <2>;
		};

		uart7: serial@74c33600 {
			compatible = "ns16550";
			reg = <0x74c33600 0x100>;
			interrupt-parent = <&intc1_4>;
			interrupts = <13 1>;
			clocks = <&sysclk1 SCU1_CLK_GATE_UART7CLK>;
			resets = <&sysrst1 SCU1_RESET_UART7>;
			pinctrl-names = "default";
			pinctrl-0 = <pinctrl_uart7_default>;
			status = "disabled";
			reg-shift = <2>;
		};

		ipc1: bus@74c39000 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "simple-bus";
			ranges = <0 0x74c39000 0x1000>;
		};

		i2c_gr: i2c-global-regs@74c0f000 {
			compatible = "aspeed,i2c-global";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f000 0x20>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			resets = <&sysrst1 SCU1_RESET_I2C>;
			clk-divider = <0xC6411208>;
		};

		i2c0: i2c@74c0f100 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f100 0x80>;
			interrupt-parent = <&intc1_2>;
			interrupts = <0 1>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			status = "disabled";
		};

		i2c1: i2c@74c0f200 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f200 0x80>;
			interrupt-parent = <&intc1_2>;
			interrupts = <1 1>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			status = "disabled";
		};

		i2c2: i2c@74c0f300 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f300 0x80>;
			interrupt-parent = <&intc1_2>;
			interrupts = <2 1>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			status = "disabled";
		};

		i2c3: i2c@74c0f400 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f400 0x80>;
			interrupt-parent = <&intc1_2>;
			interrupts = <3 1>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			status = "disabled";
		};

		i2c4: i2c@74c0f500 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f500 0x80>;
			interrupt-parent = <&intc1_2>;
			interrupts = <4 1>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			status = "disabled";
		};

		i2c5: i2c@74c0f600 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f600 0x80>;
			interrupt-parent = <&intc1_2>;
			interrupts = <5 1>;
			clocks = <&sysclk1 SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			status = "disabled";
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};

#include "ast27xx-pinctrl.dtsi"
