		};

		i3c7: i3c@74c27000 {
			compatible = "aspeed,g7-i3c-hci";
			reg = <0x74c27000 0x1000>;
			interrupts = <INTR_I3C7 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_I3C7CLK>;
			resets = <&sysrst SCU1_RESET_I3C7>, <&sysrst SCU1_RESET_I3CDMA>;
			reset-names = "core", "dma";
			i2c-scl-hz = <1000000>;
			i3c-scl-hz = <12500000>;
			io-mode = "pio";
			pinctrl-0 = <pinctrl_i3c7_default>;
			pinctrl-names = "default";
			status = "disabled";
			#address-cells = <3>;
			#size-cells = <0>;
		};

		gpio0: gpio@74c0b000 {
			compatible = "aspeed,ast10x0-g2-gpio", "aspeed,g7-gpio";
			reg = <0x74c0b000 0x1000>;
			interrupts = <INTR_GPIO AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_AHB>;
			ngpios = <216>;
			status = "disabled";

			gpio0_0_31: gpio0_0_31 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <0>;
			};
			gpio0_32_63: gpio0_32_63 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <32>;
				gpio-reserved = <0xf0000000>;
			};
			gpio0_64_95: gpio0_64_95 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <64>;
			};
			gpio0_96_127: gpio0_96_127 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <96>;
			};
			gpio0_128_159: gpio0_128_159 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <128>;
			};
			gpio0_160_191: gpio0_160_191 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <160>;
			};
			gpio0_192_215: gpio0_192_215 {
				#gpio-cells = <2>;
				gpio-controller;
				ngpios = <24>;
				pin-offset = <192>;
			};
		};

		sgpiom0: sgpiom@74c0c000 {
			compatible = "aspeed,ast10x0-g2-sgpiom", "aspeed,g7-sgpiom";
			reg = <0x74c0c000 0x100>;
			interrupts = <INTR_SGPIO0 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_APB>;
			aspeed,bus-freq = <12000000>;
			ngpios = <256>;
			status = "disabled";

			sgpiom0_0_31: sgpiom0_0_31 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <0>;
			};
			sgpiom0_32_63: sgpiom0_32_63 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <32>;
			};
			sgpiom0_64_95: sgpiom0_64_95 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <64>;
			};
			sgpiom0_96_127: sgpiom0_96_127 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <96>;
			};
			sgpiom0_128_159: sgpiom0_128_159 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <128>;
			};
			sgpiom0_160_191: sgpiom0_160_191 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <160>;
			};
			sgpiom0_192_223: sgpiom0_192_223 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <192>;
			};
			sgpiom0_224_255: sgpiom0_224_255 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <224>;
			};
		};

		wdt0: wdt@74c37000 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37000 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT0 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			reset-mask = <0x000019ec 0x2010e803 0x003e0000>;
			status = "disabled";
		};

		wdt1: wdt@74c37080 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37080 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT1 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			reset-mask = <0x000019ec 0x2010e803 0x003e0000>;
			status = "disabled";
		};

		wdt2: wdt@74c37100 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37100 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT2 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			reset-mask = <0x000019ec 0x2010e803 0x003e0000>;
			status = "disabled";
		};

		wdt3: wdt@74c37180 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37180 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT3 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			reset-mask = <0x000019ec 0x2010e803 0x003e0000>;
			status = "disabled";
		};

		wdt4: wdt@74c37200 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37200 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT4 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
