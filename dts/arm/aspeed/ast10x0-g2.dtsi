			status = "disabled";
		};

		wdt7: wdt@74c37380 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37380 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT7 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			reset-mask = <0x000019ec 0x2010e803 0x003e0000>;
			status = "disabled";
		};

		sgpiom1: sgpiom@74c0d000 {
			compatible = "aspeed,ast10x0-g2-sgpiom", "aspeed,g7-sgpiom";
			reg = <0x74c0d000 0x100>;
			interrupts = <INTR_SGPIO1 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_APB>;
			aspeed,bus-freq = <12000000>;
			ngpios = <256>;
			status = "disabled";

			sgpiom1_0_31: sgpiom1_0_31 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <0>;
			};
			sgpiom1_32_63: sgpiom1_32_63 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <32>;
			};
			sgpiom1_64_95: sgpiom1_64_95 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <64>;
			};
			sgpiom1_96_127: sgpiom1_96_127 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <96>;
			};
			sgpiom1_128_159: sgpiom1_128_159 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <128>;
			};
			sgpiom1_160_191: sgpiom1_160_191 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <160>;
			};
			sgpiom1_192_223: sgpiom1_192_223 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <192>;
			};
			sgpiom1_224_255: sgpiom1_224_255 {
				#gpio-cells = <2>;
				gpio-controller;
				pin-offset = <224>;
			};
		};

		fmc: spi@74000000 {
			compatible = "aspeed,ast10x0-g2-spi-controller";
			reg = <0x74000000 0x300>, <0x80000000 0x10000000>;
			reg-names = "ctrl_reg", "spi_mmap";
			interrupts = <INTR_FMC AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_AHB>;
			pinctrl-0 = <pinctrl_fwspi_quad_default>;
			pinctrl-names = "default";
			num-cs = <2>;
			ctrl-type = "bspi";
			#address-cells = <1>;
			#size-cells = <0>;
			spi-ctrl-caps-mask = <0x000e0e0c>;
			status = "disabled";

			fmc_cs0: fmc@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-buswidth = <1>;
				spi-max-frequency = <25000000>;
				jedec-id = [];
				write-block-size = <4096>;
				status = "okay";
			};
		};

		espi0: espi@74c05000 {
			compatible = "aspeed,espi-ast1040", "aspeed,espi-v2";
			reg = <0x74c05000 0x1000>;
			interrupts = <INTR_ESPI_GLOBAL AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_AHB>;
			aspeed,scu = <&syscon>;
			status = "disabled";
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};

