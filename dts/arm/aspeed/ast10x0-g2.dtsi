		wdt5: wdt@74c37280 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37280 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT5 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			reset-mask = <0x000019ec 0x2010e803 0x003e0000>;
			status = "disabled";
		};

		wdt6: wdt@74c37300 {
			compatible = "aspeed,ast10x0-g2-watchdog";
			reg = <0x74c37300 0x80>;
			aspeed,scu = <&syscon>;
			interrupts = <INTR_WDT6 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
