#include <arm/armv7-m.dtsi>
#include <mem.h>
#include <aspeed/ast10x0-g2-irq.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/clock/ast10x0_g2_clock.h>
#include <zephyr/dt-bindings/reset/ast10x0-g2_reset.h>
#include <zephyr/dt-bindings/pinctrl/ast10x0-g2-pinctrl-groups.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m4f";
			reg = <0>;
		};
	};

	dram_ro_region: memory@0 {
		device_type = "memory";
	};

	soc {
		syscon: syscon@74c02000 {
			compatible = "syscon";
			reg = <0x74c02000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
			sysrst: reset-controller {
				compatible = "aspeed,ast10x0-g2-reset", "aspeed,ast27xx-reset";
				#reset-cells = <1>;
			};

			sysclk: system-clock {
				compatible = "aspeed,ast10x0-g2-clock";
				#clock-cells = <1>;
			};

			adc_clk: adc_clk {
				#clock-cells = <0>;
				compatible = "fixed-factor-clock";
				clocks = <&sysclk SCU1_CLK_APB>;
				clock-mult = <1>;
				clock-div = <2>;
			};

			pinctrl: pinctrl {
				compatible = "aspeed,ast10x0-g2-pinctrl", "aspeed,g7-soc1-pinctrl";
			};
		};

		uart0: serial@74c33000 {
			compatible = "ns16550";
			reg = <0x74c33000 0x100>;
			interrupts = <INTR_UART0 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART0CLK>;
			status = "disabled";
			reg-shift = <2>;
		};

		uart1: serial@74c33100 {
			compatible = "ns16550";
			reg = <0x74c33100 0x100>;
			interrupts = <INTR_UART1 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART1CLK>;
			status = "disabled";
			reg-shift = <2>;
		};

		uart2: serial@74c33200 {
			compatible = "ns16550";
			reg = <0x74c33200 0x100>;
			interrupts = <INTR_UART2 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART2CLK>;
			pinctrl-0 = <pinctrl_uart2_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart3: serial@74c33300 {
			compatible = "ns16550";
			reg = <0x74c33300 0x100>;
			interrupts = <INTR_UART3 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART3CLK>;
			pinctrl-0 = <pinctrl_uart3_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart4: serial@74c33400 {
			compatible = "ns16550";
			reg = <0x74c33400 0x100>;
			interrupts = <INTR_UART4 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_UART4>;
			pinctrl-0 = <pinctrl_uart4_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart5: serial@74c33500 {
			compatible = "ns16550";
			reg = <0x74c33500 0x100>;
			interrupts = <INTR_UART5 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART5CLK>;
			pinctrl-0 = <pinctrl_uart5_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart6: serial@74c33600 {
			compatible = "ns16550";
			reg = <0x74c33600 0x100>;
			interrupts = <INTR_UART6 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART6CLK>;
			pinctrl-0 = <pinctrl_uart6_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart7: serial@74c33700 {
			compatible = "ns16550";
			reg = <0x74c33700 0x100>;
			interrupts = <INTR_UART7 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART7CLK>;
			pinctrl-0 = <pinctrl_uart7_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart8: serial@74c33800 {
			compatible = "ns16550";
			reg = <0x74c33800 0x100>;
			interrupts = <INTR_UART8 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART8CLK>;
			pinctrl-0 = <pinctrl_uart8_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart9: serial@74c33900 {
			compatible = "ns16550";
			reg = <0x74c33900 0x100>;
			interrupts = <INTR_UART9 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART9CLK>;
			pinctrl-0 = <pinctrl_uart9_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart10: serial@74c33a00 {
			compatible = "ns16550";
			reg = <0x74c33a00 0x100>;
			interrupts = <INTR_UART10 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART10CLK>;
			pinctrl-0 = <pinctrl_uart10_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart11: serial@74c33b00 {
			compatible = "ns16550";
			reg = <0x74c33b00 0x100>;
			interrupts = <INTR_UART11 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART11CLK>;
			pinctrl-0 = <pinctrl_uart11_default>;
			pinctrl-names = "default";
			status = "disabled";
			reg-shift = <2>;
		};

		uart12: serial@74c33c00 {
			compatible = "ns16550";
			reg = <0x74c33c00 0x100>;
			interrupts = <INTR_UART12 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_GATE_UART12CLK>;
			status = "disabled";
			reg-shift = <2>;
		};

		adc0: adc@74c00000 {
			compatible = "aspeed,ast10x0-g2-adc";
			reg = <0x74c00000 0x100>;
			clocks = <&adc_clk>;
			resets = <&sysrst SCU1_RESET_ADC>;
			interrupts = <INTR_ADC AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			#io-channel-cells = <1>;
			aspeed,scu = <&syscon>;
			aspeed,trim-data-locate = <0x9A0 0xf>;
			status = "disabled";
		};

		adc1: adc@74c00100 {
			compatible = "aspeed,ast10x0-g2-adc";
			reg = <0x74c00100 0x100>;
			clocks = <&adc_clk>;
			resets = <&sysrst SCU1_RESET_ADC>;
			interrupts = <INTR_ADC AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			#io-channel-cells = <1>;
			aspeed,scu = <&syscon>;
			aspeed,trim-data-locate = <0x9A0 0xf0>;
			status = "disabled";
		};

		jtag0: jtag@74c01000 {
			compatible = "aspeed,jtag";
			reg = <0x74c01000 0x100>;
			clocks = <&sysclk SCU1_CLK_AHB>;
			resets = <&sysrst SCU1_RESET_JTAG0>;
			interrupts = <INTR_JTAGM0 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			pinctrl-0 = <pinctrl_jtagm0_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		jtag1: jtag@74c09000 {
			compatible = "aspeed,jtag";
			reg = <0x74c09000 0x100>;
			clocks = <&sysclk SCU1_CLK_AHB>;
			resets = <&sysrst SCU1_RESET_JTAG1>;
			interrupts = <INTR_JTAGM1 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			pinctrl-0 = <pinctrl_jtagm1_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		pwm_tach: pwm_tach@740c0000 {
			reg = <0x740c0000 0x100>;
			pwm: pwm {
				compatible = "aspeed,pwm";
				#pwm-cells = <3>;
				npwms = <16>;
				clocks = <&sysclk SCU1_CLK_AHB>;
				resets = <&sysrst SCU1_RESET_PWM>;
				status = "disabled";
			};
			tach: tach {
				compatible = "aspeed,tach";
				#address-cells = <1>;
				#size-cells = <0>;
				clocks = <&sysclk SCU1_CLK_AHB>;
				resets = <&sysrst SCU1_RESET_PWM>;
				interrupts = <INTR_TACH AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				status = "disabled";
			};
		};

		udc0: udc@74120000 {
			compatible = "aspeed,udc";
			reg = <0x74120000 0x1000>;
			interrupts = <INTR_USB2C AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			num-bidir-endpoints = <22>;
			clocks = <&sysclk SCU1_CLK_GATE_USB2ACLK>;
			resets = <&sysrst SCU1_RESET_PORTC_VHUB_EHCI>;
			pinctrl-0 = <pinctrl_usb2ad_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		udc1: udc@74122000 {
			compatible = "aspeed,udc";
			reg = <0x74122000 0x1000>;
			interrupts = <INTR_USB2D AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			num-bidir-endpoints = <22>;
			clocks = <&sysclk SCU1_CLK_GATE_USB2BCLK>;
			resets = <&sysrst SCU1_RESET_PORTD_VHUB_EHCI>;
			pinctrl-0 = <pinctrl_usb2bd_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		peci: peci@74c1f000 {
			compatible = "aspeed,peci";
			reg = <0x74c1f000 0x100>;
			interrupts = <INTR_PECI AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			clocks = <&sysclk SCU1_CLK_AHB>;
			resets = <&sysrst SCU1_RESET_PECI>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2cfilter: i2c-filter@74c14000 {
			compatible = "aspeed,i2c-filter";
			reg = <0x74c14000 0x1000>;
			clocks = <&sysclk SCU1_CLK_APB>;
			interrupts = <INTR_I2C_F0 AST10X0_G2_IRQ_DEFAULT_PRIORITY>,
						 <INTR_I2C_F1 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
			pinctrl-0 = <pinctrl_smbflt1_default pinctrl_smbflt2_default>;
			pinctrl-names = "default";
			status = "disabled";
			i2cfilter0: i2cfilter0 {
				index = <0>;
				clock = <100>;
			};
			i2cfilter1: i2cfilter1 {
				index = <1>;
				clock = <100>;
			};
		};

		mbxctrl: swmbx-ctrl {
			compatible = "aspeed,swmbx-ctrl";
			size = <256>;
			status = "disabled";
		};

		i2c_gr: i2c-global-regs@74c0f000 {
			compatible = "aspeed,i2c-global";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f000 0x100>;
			clocks = <&sysclk SCU1_CLK_APB>;
			resets = <&sysrst SCU1_RESET_I2C>;
			clk-divider = <0xC6411208>;
		};

		i2c0: i2c@74c0f100 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f100 0x100>, <0x74c0f1c0 0x40>;
			interrupts = <INTR_I2C0 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c0_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c1: i2c@74c0f200 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f200 0x100>, <0x74c0f2c0 0x40>;
			interrupts = <INTR_I2C1 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c1_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c2: i2c@74c0f300 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f300 0x100>, <0x74c0f3c0 0x40>;
			interrupts = <INTR_I2C2 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c2_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c3: i2c@74c0f400 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f400 0x100>, <0x74c0f4c0 0x40>;
			interrupts = <INTR_I2C3 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c3_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c4: i2c@74c0f500 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f500 0x100>, <0x74c0f5c0 0x40>;
			interrupts = <INTR_I2C4 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c4_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c5: i2c@74c0f600 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f600 0x100>, <0x74c0f6c0 0x40>;
			interrupts = <INTR_I2C5 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c5_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c6: i2c@74c0f700 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f700 0x100>, <0x74c0f7c0 0x40>;
			interrupts = <INTR_I2C6 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c6_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c7: i2c@74c0f800 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f800 0x100>, <0x74c0f8c0 0x40>;
			interrupts = <INTR_I2C7 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c7_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c8: i2c@74c0f900 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0f900 0x100>, <0x74c0f9c0 0x40>;
			interrupts = <INTR_I2C8 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c8_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c9: i2c@74c0fa00 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0fa00 0x100>, <0x74c0fac0 0x40>;
			interrupts = <INTR_I2C9 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c9_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c10: i2c@74c0fb00 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0fb00 0x100>, <0x74c0fbc0 0x40>;
			interrupts = <INTR_I2C10 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c10_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c11: i2c@74c0fc00 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0fc00 0x100>, <0x74c0fcc0 0x40>;
			interrupts = <INTR_I2C11 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c11_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c12: i2c@74c0fd00 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0fd00 0x100>, <0x74c0fdc0 0x40>;
			interrupts = <INTR_I2C12 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
			manual-high-count = <0>;
			manual-low-count = <0>;
			manual-sda-delay = <0>;
			pinctrl-0 = <pinctrl_i2c12_default>;
			pinctrl-names = "default";
			status = "disabled";
		};

		i2c13: i2c@74c0fe00 {
			compatible = "aspeed,i2c";
			clock-frequency = <I2C_BITRATE_FAST>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74c0fe00 0x100>, <0x74c0fec0 0x40>;
			interrupts = <INTR_I2C13 1>;
			clocks = <&sysclk SCU1_CLK_APB>;
			xfer-mode = "DMA";
			multi-master = <0>;
			smbus-timeout = <1>;
