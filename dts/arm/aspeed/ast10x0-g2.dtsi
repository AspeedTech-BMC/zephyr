			compatible = "aspeed,lsc";
			reg = <0x74c31000 0x1000>;

			pcc: pcc {
				compatible = "aspeed,pcc";
				interrupts = <INTR_POSTCODE AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				status = "disabled";
			};

			snoop: snoop {
				compatible = "aspeed,snoop";
				interrupts = <INTR_SNOOP AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				status = "disabled";
			};

			mbox: mbox {
				compatible = "aspeed,mbox";
				interrupts = <INTR_LPC_MAILBOX AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				status = "disabled";
			};

			kcs1: kcs1 {
				compatible = "aspeed,kcs";
				interrupts = <INTR_KCS_1 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				chan = <1>;
				status = "disabled";
			};

			kcs2: kcs2 {
				compatible = "aspeed,kcs";
				interrupts = <INTR_KCS_2 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				chan = <2>;
				status = "disabled";
			};

			kcs3: kcs3 {
				compatible = "aspeed,kcs";
				interrupts = <INTR_KCS_3 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				chan = <3>;
				status = "disabled";
			};

			kcs4: kcs4 {
				compatible = "aspeed,kcs";
				interrupts = <INTR_KCS_4 AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				chan = <4>;
				status = "disabled";
			};

			bt: bt {
				compatible = "aspeed,bt";
				interrupts = <INTR_BT AST10X0_G2_IRQ_DEFAULT_PRIORITY>;
				status = "disabled";
			};

			uart_routing: uart-routing {
				compatible = "aspeed,ast1040-uart-routing", "aspeed,uart-routing";
				status = "disabled";
				ch-name = "uart0", "uart1", "uart2", "uart3", "UART9";
				sel-io = "io0", "io1", "io2", "io3", "io9";
				io-name = "io0", "io1", "io2", "io3", "io9";
				sel-ch = "uart0", "uart1", "uart2", "uart3", "UART9";
			};
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};

#include "ast10x0-g2-pinctrl.dtsi"
