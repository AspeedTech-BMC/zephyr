#include <mem.h>
#include <aspeed/ast1040-irq.h>
#include <zephyr/dt-bindings/clock/ast27xx_clock.h>
#include <zephyr/dt-bindings/reset/ast27xx_reset.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv32imc_zicsr_zifencei";

			hlic: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	dram_ro_region: memory@0 {
		device_type = "memory";
	};

	soc {
		compatible = "aspeed,soc", "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		syscon: syscon@14c02000 {
			compatible = "syscon";
			reg = <0x14c02000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
		};

		uart12: serial@14c33c00 {
			compatible = "ns16550";
			reg = <0x14c33c00 0x100>;
			status = "disabled";
			reg-shift = <2>;
		};

		systick: timer@14c36000 {
			compatible = "aspeed,ast2700-bootmcu-timer";
			reg = <0x14c36000 0x40>;
			interrupt-parent = <&hlic>;
			interrupts = <7 0>;
		};

		rng: hwrng@14c020f0 {
			compatible = "aspeed,hwrng";
			reg = <0x14c020f0 0x8>;
		};
	};
};
