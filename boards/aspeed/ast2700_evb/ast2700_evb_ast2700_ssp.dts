/dts-v1/;
#include <aspeed/ast27xx_ssp.dtsi>

/ {
	model = "Aspeed AST2700-SSP FPGA board";
	compatible = "aspeed,ast2700-fpga";

	chosen {
		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4;
		zephyr,flash = &dram_ro_region;
		zephyr,sram = &dram_rw_region;
	};

	dram_rw_region: memory@20000 {
		device_type = "memory";
		reg = <0x20000 DT_SIZE_K(16384 - 128)>;
	};

	/* non-cached DMA memory */
	dram_nc_region: memory@1000000 {
		compatible = "zephyr,memory-region";
		device_type = "memory";
		reg = <0x1000000 DT_SIZE_K(16384)>;
		zephyr,memory-region = "RAM_NC";
	};
};

/* .text and .rodata sections */
&dram_ro_region {
	reg = <0x0 DT_SIZE_K(128)>;
};

&uart4 {
	clock-frequency = <1846153>;
	current-speed = <115200>;
	status = "okay";
};

&ipc0_s_ca35 {
	status = "okay";
};

&ipc0_ns_ca35 {
	status = "okay";
};

&ipc0_tsp {
	status = "okay";
};

&ipc1_bootmcu {
	status = "okay";
};

&intc0_11 {
	status = "okay";
};

&intc1_0 {
	status = "okay";
};

&intc1_1 {
	status = "okay";
};

&intc1_2 {
	status = "okay";
};

&intc1_3 {
	status = "okay";
};

&intc1_4 {
	status = "okay";
};

&intc1_5 {
	status = "okay";
};

&espi0 {
	status = "okay";
	flash-edaf-mode = <0x0>;
	flash-dma-mode;
	flash-edaf-tgt-addr = <0x4 0x31000000>;
};
