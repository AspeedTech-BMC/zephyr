/dts-v1/;

#include <aspeed/ast27xx.dtsi>

/ {
	model = "AST2700-EVB AST2700-BOOTMCU";
	compatible = "aspeed,ast2700-evb-ast2700-bootmcu";

	chosen {
		zephyr,ram-console = &ram_console;
		zephyr,console = &ram_console;
		zephyr,sram = &sram;
		zephyr,entropy = &rng;
	};

	ram_console: memory@14b8a000 {
		compatible = "zephyr,memory-region";
		reg = <0x14b8a000 0x1000>;
		zephyr,memory-region = "RAM_CONSOLE";
	};

	aliases {
		systick = &systick;
		emmc = &emmc;
	};

	sram: memory@14ba8000 {
		reg = <0x14ba8000 0x17800>;
	};
};

&uart12 {
	status = "okay";
	clock-frequency = <1846153>;
	current-speed = <115200>;
};

#if 0
&ipc1_s_ca35 {
	status = "okay";
};

&ipc1_ns_ca35 {
	status = "okay";
};
#endif

&ipc1_ssp {
	status = "okay";
};

#if 0
&ipc1_tsp {
	status = "okay";
};
#endif

&cptra_ecdsa {
	status = "okay";
};

&cptra_sha {
	status = "okay";
};

&cptra_lms {
	status = "okay";
};

&cptra_update {
	status = "okay";
};

&cptra_dice {
	status = "okay";
};

&cptra_misc {
	status = "okay";
};
