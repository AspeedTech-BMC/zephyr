config BOARD_AST2700_EVB
	select SOC_AST2700_SSP if BOARD_AST2700_EVB_AST2700_SSP
	select SOC_AST2700_TSP if BOARD_AST2700_EVB_AST2700_TSP
	select SOC_AST2700_IBEX if BOARD_AST2700_EVB_AST2700_IBEX
	select SOC_AST2700_A0_SSP if BOARD_AST2700_EVB_AST2700_A0_SSP
	select SOC_AST2700_A0_TSP if BOARD_AST2700_EVB_AST2700_A0_TSP
