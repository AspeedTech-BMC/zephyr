#
# Aspeed AST2700 Evaluation board configuration
#
# Copyright (c) 2023 Aspeed Technology Inc.

config BOARD_AST2700_FPGA
	select SOC_AST2700_SSP if BOARD_AST2700_FPGA_AST2700_SSP
	select SOC_AST2700_SSP if BOARD_AST2700_FPGA_AST2700_SSP_TSP
	select SOC_AST2700_TSP if BOARD_AST2700_FPGA_AST2700_TSP
	select SOC_AST2700_BOOTMCU if BOARD_AST2700_FPGA_AST2700_BOOTMCU

config ASPEED_FPGA
	bool "ASPEED FPGA support"
	default n
	help
	  Enable support for ASPEED FPGA devices.

if SHELL
config SHELL_PROMPT_UART
	default "ssp:~$ " if BOARD_AST2700_EVB_AST2700_SSP || BOARD_AST2700_EVB_AST2700_A0_SSP
	default "tsp:~$ " if BOARD_AST2700_EVB_AST2700_TSP || BOARD_AST2700_EVB_AST2700_A0_TSP
	default "ssp_tsp:~$ " if BOARD_AST2700_EVB_AST2700_SSP_TSP
	default "bootmcu:~$ " if BOARD_AST2700_EVB_AST2700_BOOTMCU
endif
