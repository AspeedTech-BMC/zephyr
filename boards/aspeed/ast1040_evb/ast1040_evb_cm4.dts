	};
	sgpiom0_64_95 {
		status = "okay";
	};
	sgpiom0_96_127 {
		status = "okay";
	};
	sgpiom0_128_159 {
		status = "okay";
	};
	sgpiom0_160_191 {
		status = "okay";
	};
	sgpiom0_192_223 {
		status = "okay";
	};
	sgpiom0_224_255 {
