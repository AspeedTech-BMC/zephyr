/dts-v1/;
#include <arm/aspeed/ast1040.dtsi>

/ {
	model = "Aspeed AST1040 Evaluation board";
	compatible = "aspeed,ast1040-evb";

	chosen {
		zephyr,console = &uart12;
		zephyr,shell-uart = &uart12;
		zephyr,flash = &dram_ro_region;
		zephyr,sram = &sram;
	};

	dram_rw_region: memory@20000 {
		device_type = "memory";
		reg = <0x20000 DT_SIZE_K(128)>;
	};

	sram1: memory@60000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0x60000 DT_SIZE_K(128)>;
		zephyr,memory-region = "RAM_NC";
	};

	sram: memory@40000 {
		device_type = "memory";
		reg = <0x40000 DT_SIZE_K(128)>;
	};
};

&uart12 {
	clock-frequency = <1846153>;
	current-speed = <115200>;
	status = "okay";
};

&dram_ro_region {
	reg = <0x0 DT_SIZE_K(128)>;
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};

&i2c0 {
	status = "okay";

	eeprom0: eeprom@40 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x40>;
		size = <256>;
	};

	ipmb0: ipmb@60 {
		compatible = "aspeed,ipmb";
		reg = <0x60>;
		size = <5>;
	};
};

&i2c1 {
	status = "okay";

	eeprom1: eeprom@41 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x41>;
		size = <256>;
	};

	ipmb1: ipmb@61 {
		compatible = "aspeed,ipmb";
		reg = <0x61>;
		size = <5>;
	};
};

&i2c2 {
	status = "okay";

	eeprom2: eeprom@42 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x42>;
		size = <256>;
	};

	ipmb2: ipmb@62 {
		compatible = "aspeed,ipmb";
		reg = <0x62>;
		size = <5>;
	};
};

&i2c3 {
	status = "okay";

	eeprom3: eeprom@43 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x43>;
		size = <256>;
	};

	ipmb3: ipmb@63 {
		compatible = "aspeed,ipmb";
		reg = <0x63>;
		size = <5>;
	};
};

&i2c4 {
	status = "okay";

	eeprom4: eeprom@44 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x44>;
		size = <256>;
	};

	ipmb4: ipmb@64 {
		compatible = "aspeed,ipmb";
		reg = <0x64>;
		size = <5>;
	};
};

&i2c5 {
	status = "okay";

	eeprom5: eeprom@45 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x45>;
		size = <256>;
	};

	ipmb5: ipmb@65 {
		compatible = "aspeed,ipmb";
		reg = <0x65>;
		size = <5>;
	};
};
