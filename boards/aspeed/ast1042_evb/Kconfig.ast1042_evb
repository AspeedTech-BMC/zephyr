config BOARD_AST1042_EVB
	select SOC_AST1042_CM4 if BOARD_AST1042_EVB_AST1042_CM4
	select SOC_AST1042_BOOTMCU if BOARD_AST1042_EVB_AST1042_BOOTMCU

config ASPEED_FPGA
	bool "ASPEED FPGA support"
	default n
	help
	  Enable support for ASPEED FPGA devices.

config ASPEED_HAPS
	bool "ASPEED HAPS support"
	default n
	help
	  Enable support for ASPEED HAPS devices.
